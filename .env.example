# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Instagram Graph API ---
IG_USER_ID=              # Instagram Business/Creator account ID (not the username)
IG_ACCESS_TOKEN=         # long-lived token: instagram_basic, instagram_content_publish, instagram_manage_insights
GRAPH_VERSION=v23.0      # bump if Meta retires this version

# --- Public media hosting (Cloudinary) ---
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Telegram approval bot (create with @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=        # your numeric chat id (message @userinfobot)

# --- Scheduling ---
TIMEZONE=Asia/Kolkata
POST_SLOTS=09:00,13:00,19:00
MAX_POSTS_PER_DAY=2

# --- Safety: nothing is posted while true. Test first. ---
DRY_RUN=true

# --- AI generation (opt-in) ---
ENABLE_GENERATION=false
MAX_GENERATIONS_PER_DAY=2
QUEUE_TARGET=3                     # generate only when fewer than this many posts are waiting
IMAGE_PROVIDERS=a1111,cloudflare,gemini   # tried in order; unconfigured ones are skipped
A1111_URL=http://127.0.0.1:7860    # your local GPU (AUTOMATIC1111/Forge with --api). Docker: http://host.docker.internal:7860
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# BRAND_FONT=C:/Windows/Fonts/arialbd.ttf   # set to your brand's bold .ttf for on-brand Reels

# --- Ops ---
LOG_LEVEL=info
PORT=8080
